---
import type { Offer } from "@config";

interface Props {
  offer: Offer;
  cta: { label: string; url: string };
}

const {
  offer: { name, price, duration, whoFor, deliverables },
  cta,
} = Astro.props;
---

<article class="card flex flex-col gap-5 p-6 md:p-8">
  <h3 class="text-xl md:text-2xl font-semibold tracking-tight">{name}</h3>
  <p class="flex flex-col gap-1">
    <span class="font-mono text-2xl font-bold tabular-nums text-price"
      >{price}</span
    >
    <span class="font-mono text-xs uppercase tracking-wider text-muted"
      >{duration}</span
    >
  </p>
  <p>{whoFor}</p>
  <ul class="marked-list flex flex-col gap-2 grow text-[15px]">
    {deliverables.map((deliverable) => <li>{deliverable}</li>)}
  </ul>
  <p class="pt-4 border-t border-line">
    <a href={cta.url} class="font-semibold">{cta.label} →</a>
  </p>
</article>
