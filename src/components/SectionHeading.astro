---
interface Props {
  index: number;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="flex flex-col gap-3 mb-10">
  <p
    class="flex items-center gap-3 font-mono text-sm font-bold tracking-widest text-accent"
  >
    <span class="bar" aria-hidden="true"></span>
    {String(index).padStart(2, "0")}
  </p>
  <h2 class="text-4xl md:text-5xl font-bold tracking-tight">{title}</h2>
</div>
