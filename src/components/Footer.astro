---
import { SCOPE_NOTE, SITE } from "@config";

const year = new Date().getFullYear();
---

<footer id="contact" class="max-w-screen-lg w-full mx-auto px-4 mt-16">
  <div class="pt-12 pb-10 border-t border-sky-300 dark:border-sky-800">
    <h2 class="text-2xl font-semibold mb-4">Contact</h2>
    <p class="max-w-prose mb-6">{SCOPE_NOTE}</p>

    <ul class="flex flex-col gap-2 mb-8">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.bookingUrl}>Book an intro call</a></li>
      <li>
        <a href={SITE.founderUrl}>{SITE.founderName}, founder</a>
      </li>
    </ul>

    <p class="text-sm">&copy; {year} {SITE.legalName} · {SITE.location}</p>
  </div>
</footer>
