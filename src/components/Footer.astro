---
import { SCOPE_NOTE, SITE } from "@config";

const year = new Date().getFullYear();
---

<!-- Deep petrol in both themes, matching the hero. -->
<footer id="contact" class="theme-deep">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8 pt-16 pb-10">
    <p
      class="flex items-center gap-3 font-mono text-sm font-bold tracking-widest text-accent mb-3"
    >
      <span class="bar" aria-hidden="true"></span>
      04
    </p>
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">
      Contact
    </h2>
    <p class="max-w-prose text-muted mb-10">{SCOPE_NOTE}</p>

    <ul class="flex flex-col gap-3 text-xl md:text-2xl font-medium mb-16">
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><a href={SITE.bookingUrl}>Book an intro call →</a></li>
      <li>
        <a href={SITE.founderUrl}>{SITE.founderName}, founder</a>
      </li>
    </ul>

    <p
      class="pt-6 border-t border-line font-mono text-xs uppercase tracking-wider text-muted"
    >
      &copy; {year} {SITE.legalName} · {SITE.location}
    </p>
  </div>
</footer>
