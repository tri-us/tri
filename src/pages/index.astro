---
import { HERO, HOW_WE_WORK, OFFERS, SITE, TEAM } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import OfferCard from "@components/OfferCard.astro";

const offerCta = { label: "Book an intro call", url: SITE.bookingUrl };
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="flex flex-col gap-6 pt-16 pb-12 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-bold leading-tight">
      {HERO.headline}
    </h1>
    <p class="text-lg md:text-xl max-w-prose">{HERO.subhead}</p>
    <div class="flex flex-wrap items-center gap-6">
      <a
        href={HERO.primary.url}
        class="no-underline px-5 py-3 rounded-md font-semibold bg-sky-800 text-sky-50 hover:bg-sky-900 dark:bg-sky-300 dark:text-sky-950 dark:hover:bg-sky-200"
      >
        {HERO.primary.label}
      </a>
      <a href={HERO.secondary.url}>{HERO.secondary.label}</a>
    </div>
  </section>

  <section id="services" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">Services</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {OFFERS.map((offer) => <OfferCard offer={offer} cta={offerCta} />)}
    </div>
  </section>

  <section id="how-we-work" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">How we work</h2>
    <div class="flex flex-col gap-4 max-w-prose">
      {HOW_WE_WORK.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="team" class="py-12">
    <h2 class="text-2xl font-semibold mb-6">Team</h2>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        TEAM.map(({ role, name, url, background }) => (
          <li class="flex flex-col gap-2 py-4 border-t border-sky-300 dark:border-sky-800">
            <h3 class="text-lg font-semibold">
              {name && url ? <a href={url}>{name}</a> : name}
              <span class:list={["block", name && "text-base font-normal"]}>
                {role}
              </span>
            </h3>
            <p>{background}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
